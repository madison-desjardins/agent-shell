{
  "name": "Travel Agent Chatbot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install --upgrade -r requirements.txt",
  "postStartCommand": "python -m pip install --upgrade -r requirements.txt",
  "forwardPorts": [
    7860
  ],
  "portsAttributes": {
    "7860": {
      "label": "Gradio Travel Agent",
      "onAutoForward": "open",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
